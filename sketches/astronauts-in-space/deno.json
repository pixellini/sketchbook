{
    "version": "1.0.0",
    "compilerOptions": {
        "lib": ["dom", "dom.iterable", "es2020"]
    },
    "tasks": {
        "dev": "deno run -A --node-modules-dir=auto npm:vite",
        "build": "deno run -A --node-modules-dir=auto npm:vite build",
        "serve": "deno run -A --node-modules-dir=auto npm:vite preview",
        "lint": "deno lint",
        "create-spritesheet": "bash scripts/create-spritesheet.sh",
        "create-spritesheet:iss": "CRAFT=iss deno task create-spritesheet",
        "create-spritesheet:tiangong": "CRAFT=tiangong deno task create-spritesheet"
    },
    "lint": {
        "include": ["src/"],
        "rules": {
            "exclude": ["no-unused-vars", "no-explicit-any"]
        }
    }
}
